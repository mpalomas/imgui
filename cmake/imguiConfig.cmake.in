@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies based on which backends were built
set(_IMGUI_BUILD_BACKEND_SDL3 @IMGUI_BUILD_BACKEND_SDL3@)
set(_IMGUI_BUILD_BACKEND_SDL3_RENDERER @IMGUI_BUILD_BACKEND_SDL3_RENDERER@)
set(_IMGUI_BUILD_BACKEND_VULKAN @IMGUI_BUILD_BACKEND_VULKAN@)
set(_IMGUI_BUILD_BACKEND_WGPU @IMGUI_BUILD_BACKEND_WGPU@)

# Consumer can set these variables before find_package(imgui) to specify dependency locations
# e.g., set(SDL3_DIR "/path/to/SDL3") before find_package(imgui)

if(_IMGUI_BUILD_BACKEND_SDL3 OR _IMGUI_BUILD_BACKEND_SDL3_RENDERER)
    find_dependency(SDL3 CONFIG)
endif()

if(_IMGUI_BUILD_BACKEND_VULKAN)
    find_dependency(Vulkan)
endif()

if(_IMGUI_BUILD_BACKEND_WGPU)
    find_dependency(webgpu_dawn CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/imguiTargets.cmake")

check_required_components(imgui)
